diff --git a/src/hero_coach/hero_coach/traffic_sign_bridge.py b/src/hero_coach/hero_coach/traffic_sign_bridge.py
new file mode 100644
index 0000000..ca09ddb
--- /dev/null
+++ b/src/hero_coach/hero_coach/traffic_sign_bridge.py
@@ -0,0 +1,70 @@
+"""YOLO detections -> the coach's traffic light and sign topics (plan 29).
+
+In:  /yolo/detections (std_msgs/String JSON from src/yolo_signs: stamp, image_width, detections [{class_name,
+     confidence, xyxy}]).
+Out: /hero/traffic_light (hero_hud/SignalIndicator) and /hero/sign (hero_hud/SignMarker, KIND_SPEED + value,
+     SOURCE_FRONT), the topics hero_coach's coach_node reads (in simulation carla_traffic fills them; the coach does
+     not ask which).  lane_guidance reads the same topics.
+What is shown comes from traffic_signs.SignTracker (2 of the last 3 messages, light off 0.5 s after the last light,
+sign kept 3 s; with several lights the large, central one wins).  While something is confirmed it is sent again with
+every detection message (the coach drops what is older than signal_timeout_sec, 1 s); when it goes off,
+STATE_NONE / KIND_UNKNOWN is sent once.  Parameters: input_topic, signal_topic, sign_topic and sign.<SignSettings
+field> (e.g. sign.select_centre_sigma)."""
+import json
+
+import rclpy
+from rclpy.executors import ExternalShutdownException
+from rclpy.node import Node
+from std_msgs.msg import String
+
+from .traffic_signs import SignTracker, SignSettings
+
+STATES = {'red': 1, 'yellow': 2, 'green': 3}  # SignalIndicator.STATE_RED / YELLOW / GREEN
+
+
+class TrafficSignBridge(Node):
+    def __init__(self):
+        super().__init__('traffic_sign_bridge')
+        p = lambda name, default: self.declare_parameter(name, default).value
+        settings = SignSettings()
+        for name in settings.__dataclass_fields__:
+            setattr(settings, name, type(getattr(settings, name))(p('sign.'+name, getattr(settings, name))))
+        self.tracker = SignTracker(settings)
+        from hero_hud.msg import SignalIndicator, SignMarker
+        self.SignalIndicator, self.SignMarker = SignalIndicator, SignMarker
+        self.signal_pub = self.create_publisher(SignalIndicator, p('signal_topic', '/hero/traffic_light'), 10)
+        self.sign_pub = self.create_publisher(SignMarker, p('sign_topic', '/hero/sign'), 10)
+        self.create_subscription(String, p('input_topic', '/yolo/detections'), self.on_detections, 10)
+        self.shown = (None, None)
+        self.get_logger().info('Traffic sign bridge: '+str(settings))
+
+    def on_detections(self, msg):
+        data = json.loads(msg.data);stamp = data.get('stamp', {})
+        t = float(stamp.get('sec', 0))+float(stamp.get('nanosec', 0))*1e-9
+        self.tracker.update(t, data.get('detections', []), data.get('image_width'))
+        light, sign = self.tracker.state(t)
+        for out in messages(self.SignalIndicator, self.SignMarker, light, sign, self.shown, self.tracker):
+            (self.signal_pub if isinstance(out, self.SignalIndicator) else self.sign_pub).publish(out)
+        self.shown = (light, sign)
+
+
+def messages(SignalIndicator, SignMarker, light, sign, shown, tracker):
+    """The messages to send for this detection message: the confirmed light and sign (again each time), and
+    STATE_NONE / KIND_UNKNOWN once when one goes off."""
+    out = []
+    if light is not None or shown[0] is not None:
+        m = SignalIndicator();m.state = STATES[light] if light is not None else SignalIndicator.STATE_NONE;out.append(m)
+    if sign is not None or shown[1] is not None:
+        m = SignMarker();m.source = SignMarker.SOURCE_FRONT
+        if sign is not None:m.kind = SignMarker.KIND_SPEED;m.value = float(sign);m.confidence = float(tracker.sign_confidence)
+        else:m.kind = SignMarker.KIND_UNKNOWN
+        out.append(m)
+    return out
+
+
+def main():
+    rclpy.init();node = TrafficSignBridge()
+    try:rclpy.spin(node)
+    except (KeyboardInterrupt, ExternalShutdownException):pass  # Ctrl+C or a launch shutdown
+    finally:
+        node.destroy_node();rclpy.try_shutdown()
diff --git a/src/hero_coach/hero_coach/traffic_advice.py b/src/hero_coach/hero_coach/traffic_advice.py
new file mode 100644
index 0000000..426ed43
--- /dev/null
+++ b/src/hero_coach/hero_coach/traffic_advice.py
@@ -0,0 +1,89 @@
+"""Traffic light + stop line advice, and the speed limit (plan 29).  Pure Python, no ROS.
+
+lane_guidance_node puts the result into /hero/lane_guidance as "traffic" and, for a red or yellow light with a stop
+advice, ends the lane guidance ribbon at the stop line.
+
+Distance to the car's front end: d = stop_line_m (rear axle to the line) - front_overhang_m (rear axle to the front
+bumper: 3.656 m, Prius gen 3, docs/설계.md).  Deceleration needed: a = v^2 / (2 max(d, 0.1 m)).
+
+  light red:    |v| < stopped_mps                    -> 'hold'
+                no stop line known                   -> 'stop_unknown_distance' (distance and deceleration null)
+                d <= 0 and moving                    -> 'over_line'
+                a <= prepare_decel_mps2 (2.0)        -> 'prepare_stop'
+                a <= stop_decel_mps2 (3.5)           -> 'stop'
+                else                                 -> 'stop_hard'
+  light yellow: no stop line known                   -> 'stop_unknown_distance'
+                a <= stop_decel_mps2                 -> as red
+                else (cannot stop before the line)   -> 'proceed'
+  green / none:                                      -> 'none'
+
+Speed limit: the last confirmed speed sign is kept until the next one (speed_limit_kph); over_limit is true once the
+speed has been above the limit + over_limit_kph for over_limit_s.
+"""
+import math
+from dataclasses import dataclass
+
+STOP_ADVICE = ('hold', 'prepare_stop', 'stop', 'stop_hard')  # the ribbon ends at the stop line for these
+
+
+@dataclass
+class AdviceSettings:
+    front_overhang_m: float = 3.656   # rear axle to the front bumper (Prius gen 3, docs/설계.md)
+    prepare_decel_mps2: float = 2.    # up to this a gentle stop: prepare
+    stop_decel_mps2: float = 3.5      # up to this a firm stop; above it hard (red) or go on (yellow)
+    stopped_mps: float = .3           # below this the car is standing
+    min_distance_m: float = .1        # d in the deceleration is at least this
+    over_limit_kph: float = 5.        # over the speed limit by more than this ...
+    over_limit_s: float = 1.          # ... for this long: over_limit
+
+
+def advise(light, stop_line_m, speed_mps, s=None):
+    """dict(advice, distance_m (to the car's front, or None), decel_mps2 (or None))."""
+    s = s or AdviceSettings()
+    v = abs(float(speed_mps or 0.))
+    if light not in ('red', 'yellow'):return dict(advice='none', distance_m=None, decel_mps2=None)
+    d = None if stop_line_m is None else float(stop_line_m)-s.front_overhang_m
+    a = None if d is None else v*v/(2.*max(d, s.min_distance_m))
+    out = lambda advice: dict(advice=advice, distance_m=None if d is None else round(d, 2), decel_mps2=None if a is None else round(a, 2))
+    if light == 'red' and v < s.stopped_mps:return out('hold')
+    if d is None:return dict(advice='stop_unknown_distance', distance_m=None, decel_mps2=None)
+    if light == 'yellow' and a > s.stop_decel_mps2:return out('proceed')
+    if light == 'yellow' and v < s.stopped_mps:return out('hold')
+    if d <= 0. and v >= s.stopped_mps:return out('over_line')
+    if a <= s.prepare_decel_mps2:return out('prepare_stop')
+    if a <= s.stop_decel_mps2:return out('stop')
+    return out('stop_hard')
+
+
+class SpeedLimit:
+    """The last confirmed speed sign until the next one, and whether the car is over it."""
+
+    def __init__(self, settings=None):
+        self.s = settings or AdviceSettings();self.reset()
+
+    def reset(self):
+        self.limit = None;self.over_since = None;self.last = None
+
+    def update(self, t, sign_kph, speed_mps):
+        """t (s), the confirmed sign now (km/h or None) and the speed; returns (limit km/h or None, over_limit)."""
+        if self.last is not None and t < self.last-.5:self.reset()  # replay restarted
+        self.last = t
+        if sign_kph is not None:self.limit = float(sign_kph)
+        over = False
+        if self.limit is not None and speed_mps is not None and abs(speed_mps)*3.6 > self.limit+self.s.over_limit_kph:
+            if self.over_since is None:self.over_since = t
+            over = t-self.over_since >= self.s.over_limit_s
+        else:self.over_since = None
+        return self.limit, over
+
+
+def cut_at(points, x_end):
+    """A ribbon (base_link [(x, y), ...], from the car) ending at x = x_end: points past it removed, the last one
+    interpolated onto it.  Fewer than 2 points left: []."""
+    out = []
+    for i, (x, y) in enumerate(points):
+        if x <= x_end:out.append((x, y));continue
+        if out:
+            x0, y0 = out[-1];u = (x_end-x0)/(x-x0) if x != x0 else 0.;out.append((x_end, y0+u*(y-y0)))
+        break
+    return out if len(out) >= 2 else []
