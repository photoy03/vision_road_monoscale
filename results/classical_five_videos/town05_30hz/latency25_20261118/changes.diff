+    /usr/bin/python3 "$ROAD/tools/replay_maploop.py" --bag "$BAG" --cache "$CACHE" --max-frames "$FRAMES" --rate 1 ${CROP[@]+"${CROP[@]}"}
     [ "$LOOP" = 1 ] || break
