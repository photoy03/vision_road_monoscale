<?xml version="1.0"?>
<package format="3">
  <name>monoscale_pose</name>
  <version>0.1.0</version>
  <description>Existing yaw correction, pose resampling and sole map-to-base TF authority; shared header-only pose-at-timestamp lookup (pose_timeline.hpp).</description>
  <maintainer email="jaehun@todo.todo">jaehun</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>vision_lane_interfaces</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
