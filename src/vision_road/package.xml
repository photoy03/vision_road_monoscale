  <maintainer email="jaehun@example.com">jaehun</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <build_depend>pybind11-dev</build_depend><build_depend>libopencv-dev</build_depend><build_depend>python3-dev</build_depend>
